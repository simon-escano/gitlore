# Cerebras Cloud — Ultra-fast inference (Free Tier)
# Set via: npx wrangler secret put CEREBRAS_API_KEY
# CEREBRAS_API_KEY=your_api_key_here

# Cerebras model (set in wrangler.toml, override here for local dev)
# CEREBRAS_MODEL=llama3.1-8b

# GitHub PAT — optional, increases rate limit from 60/hr to 5,000/hr
# Get one free at: https://github.com/settings/tokens (no payment required)
# Set via: npx wrangler secret put GITHUB_PAT
# GITHUB_PAT=

# Context budget tuning (set in wrangler.toml, override here for local dev)
# MAX_CONTEXT_CHARS=12000
