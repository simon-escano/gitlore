# Ollama — the ONLY inference provider. No cloud keys. Ever.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_NUM_THREADS=8  # Uncomment to manually max out your CPU cores

# GitHub PAT — optional, increases rate limit from 60/hr to 5,000/hr
# Get one free at: https://github.com/settings/tokens (no payment required)
GITHUB_PAT=

# Server
PORT=3000

# Tuning
# MAX_CONTEXT_CHARS=24000
